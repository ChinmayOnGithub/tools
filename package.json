{
  "name": "online-tools-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "copy:worker": "node scripts/copy-pdf-worker.js",
    "postinstall": "node scripts/copy-pdf-worker.js",
    "prebuild": "node scripts/validate-tools.js && node scripts/copy-pdf-worker.js",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "node scripts/validate-tools.js",
    "verify": "node scripts/validate-tools.js && pnpm run typecheck && pnpm run lint && pnpm run test",
    "setup:hooks": "node scripts/setup-hooks.js",
    "prepare": "node scripts/setup-hooks.js"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^1.23.0",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.1.200",
    "qrcode": "^1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^26.1.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
